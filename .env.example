# Required.
DISCORD_BOT_TOKEN=your_token_here
WIKI_ROLE_ID=role_id_here
WIKI_ADMIN_ROLE_ID=role_id_here

# Postgres credentials. Shared by the database and the app under compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wiki

# Where the database is. Compose pins these to its own network and ignores
# whatever is set here; they matter when running the app outside compose.
#POSTGRES_HOST=localhost
#POSTGRES_PORT=5432
#POSTGRES_SSLMODE=disable

# Connection pool.
#POSTGRES_MAX_CONNS=10
#POSTGRES_MAX_CONN_LIFETIME=1h
#POSTGRES_CONNECT_TIMEOUT=5s

# Language wikis to read, comma separated.
#LOCALES=ru,ua,en,br

# Sync. BATCH_SIZE is capped at 500 by MediaWiki. INITIAL_LOOKBACK is how far
# back a locale starts when it has no cursor yet. MAX_DURATION budgets one run;
# MIN_INTERVAL is how long a locale is left alone after one.
#SYNC_BATCH_SIZE=500
#INITIAL_LOOKBACK=720h
#SYNC_MIN_INTERVAL=1m
#SYNC_MAX_DURATION=20s
#SYNC_CONCURRENCY=8

# Dead letter: revisions that could not be priced, and how hard to retry them.
#DEAD_LETTER_MAX_ATTEMPTS=5
#DEAD_LETTER_BATCH_SIZE=100
#REPLAY_INTERVAL=5m

# How long the /edits reply stays in the channel. 0 keeps it forever.
#MESSAGE_LIFETIME=2m
